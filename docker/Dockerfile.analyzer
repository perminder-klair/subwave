# subwave-analyzer — acoustic-analysis sidecar (bpm/key/intro/loudness, plus
# optional CLAP "sounds-like" embeddings and Demucs vocal-activity ranges).
# Default-on service in every compose file; the controller POSTs to it via
# ANALYZE_URL. A thin FastAPI front (docker/analyzer/server.py) supervises the
# SAME stdio worker the controller uses (controller/scripts/analyze_worker.py).
#
# Three published flavours (.github/workflows/publish-images.yml):
#   * subwave-analyzer        — LEAN (default), ~1.1GB, multi-arch, no torch.
#   * subwave-analyzer-heavy  — CLAP + Demucs baked (~1.9GB), amd64-only,
#       CPU torch. Selected by ANALYZER_HEAVY=1 in .env.
#   * subwave-analyzer-cuda   — heavy + cu128 torch, amd64-only. Selected by
#       the docker-compose.analyzer-gpu.yml overlay (a device reservation
#       can't be toggled from .env).
# Models are NOT baked — the heavy worker downloads weights into HF_HOME on
# first use; compose mounts a named volume over that cache. That makes the
# heavy tier's FIRST sounds-like/vocals pass a one-time outbound dependency on
# huggingface.co, which is documented (and given an offline pre-seed recipe) in
# docs/tts-heavy.md — a host without reach fails there, and the analyzer now
# reports the reason on /health rather than degrading silently.
#
# One model IS baked, into every flavour: the Beat This! downbeat tracker
# (ANALYZE_DOWNBEATS=beat-this, off by default), ~10 MB of ONNX exported in
# the stage below.

# ---- Beat This! downbeat model ---------------------------------------------
# Exported from the sha256-pinned upstream checkpoint by tools/beat-this/
# export.py, which fails the build unless onnxruntime reproduces PyTorch's
# logits on upstream's own test recording. Only the .onnx leaves this stage,
# so the analyzer itself stays torch-free. $BUILDPLATFORM: an arm64 build
# exports natively on the build host instead of emulating torch, and the file
# is the same on every architecture. Keep the pins in lockstep with
# docker/Dockerfile.aio and tools/beat-this/README.md. This makes every image
# build fetch the checkpoint from the maintainer's mirror; the README lists
# the hosting alternatives.
FROM --platform=$BUILDPLATFORM python:3.11-slim-bookworm AS beat-this
ARG BEAT_THIS_COMMIT=ad7974846029835307ba19a3d5cefbf40b243041
ARG BEAT_THIS_CKPT_URL=https://f0k.de/pubs/2024_ismir/beat_this-small0.ckpt
ARG BEAT_THIS_CKPT_SHA256=6074be2c4d490c5f6101fcc374a1ec72ae93456e23bb6019783b849f5dc7d47b
ARG BEAT_THIS_AUDIO_SHA256=af695e220645a1fe2314282dace96f2353c84de2364c27066e4944e3e6d66ffa
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/export && \
    /opt/export/bin/pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cpu \
      --extra-index-url https://pypi.org/simple \
      torch==2.7.1 torchaudio==2.7.1 einops==0.8.0 rotary-embedding-torch==0.6.4 \
      soxr==1.1.0 soundfile==0.14.0 onnx==1.18.0 onnxruntime==1.27.0 \
      "beat_this @ https://github.com/CPJKU/beat_this/archive/${BEAT_THIS_COMMIT}.tar.gz"
COPY tools/beat-this/export.py /build/export.py
RUN cd /build && \
    curl -fsSL --retry 3 -o small0.ckpt "$BEAT_THIS_CKPT_URL" && \
    curl -fsSL --retry 3 -o test.mp3 \
      "https://raw.githubusercontent.com/CPJKU/beat_this/${BEAT_THIS_COMMIT}/tests/It%20Don't%20Mean%20A%20Thing%20-%20Kings%20of%20Swing.mp3" && \
    echo "${BEAT_THIS_AUDIO_SHA256}  test.mp3" | sha256sum -c - && \
    /opt/export/bin/python export.py --ckpt small0.ckpt --sha256 "$BEAT_THIS_CKPT_SHA256" \
      --out beat_this-small0.onnx --audio test.mp3

FROM python:3.11-slim-bookworm

# ffmpeg + libsndfile1: librosa codec coverage for the Navidrome stream
# formats. curl: operator healthchecks.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# --- Analyzer venv ----------------------------------------------------------
# CLAP + Demucs are the heavy tier (~1.5GB each, CPU torch) — OFF by default so
# the lean image stays small and multi-arch. At runtime each still needs its
# own flag (ANALYZE_AUDIO_EMBEDDING / ANALYZE_VOCAL_ACTIVITY or the admin
# toggle); with the stack absent those are clean no-ops.
#
# All pins exact for reproducible rebuilds — keep in lockstep with the mirrored
# analyzer block in docker/Dockerfile.aio. torch/torchaudio held at 2.7.1 on
# both cpu and cu128 indexes, including cp313 wheels for the AIO. cu128 adds
# Blackwell (sm_120) kernels and vendors the runtime as nvidia-*-cu12 deps.
# Chatterbox's separate venv keeps its own upstream torch pin.
#
# onnxruntime is in the LEAN set (the Beat This downbeat model needs it, and
# it is torch-free), so every tier gets the one pin and the heavy tier's CLAP
# ONNX route reuses it. It stays the CPU build even under WITH_CUDA: the ONNX
# paths are the downbeat model and the CLAP_MODEL_PATH custom-export route,
# and onnxruntime-gpu drags in a fragile CUDA/cuDNN matrix. The transformers
# path runs on the GPU.
ARG WITH_CLAP=0
ARG WITH_DEMUCS=0
ARG WITH_CUDA=0
ENV ANALYZER_HF_HOME=/opt/analyzer/hf-cache
RUN TORCH_INDEX="https://download.pytorch.org/whl/cpu" && \
    if [ "$WITH_CUDA" = "1" ]; then TORCH_INDEX="https://download.pytorch.org/whl/cu128"; fi && \
    python3 -m venv /opt/analyzer/venv && \
    /opt/analyzer/venv/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/analyzer/venv/bin/pip install --no-cache-dir librosa==0.11.0 soundfile==0.14.0 pyloudnorm==0.2.0 \
      onnxruntime==1.27.0 && \
    if [ "$WITH_CLAP" = "1" ]; then \
      /opt/analyzer/venv/bin/pip install --no-cache-dir \
        --index-url "$TORCH_INDEX" \
        --extra-index-url https://pypi.org/simple \
        torch==2.7.1 transformers==5.13.0 && \
      /opt/analyzer/venv/bin/python -c "import torch, transformers, onnxruntime" ; \
    fi && \
    if [ "$WITH_DEMUCS" = "1" ]; then \
      # diffq decompresses demucs' quantized checkpoints — without it a
      # DEMUCS_MODEL=*_q override makes demucs fatal() at load. It ships
      # sdist-only (Cython ext): lend it gcc and purge in the SAME layer.
      apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && \
      /opt/analyzer/venv/bin/pip install --no-cache-dir \
        --index-url "$TORCH_INDEX" \
        --extra-index-url https://pypi.org/simple \
        torch==2.7.1 torchaudio==2.7.1 demucs==4.0.1 diffq==0.2.4 && \
      /opt/analyzer/venv/bin/python -c "import torch, torchaudio, demucs, diffq" && \
      apt-get purge -y gcc libc6-dev && apt-get autoremove -y && rm -rf /var/lib/apt/lists/* ; \
    fi && \
    find /opt/analyzer/venv -depth -type d -name __pycache__ -exec rm -rf {} +

# --- Server venv (FastAPI only — spawns the stdio worker, no model loading) --
RUN python3 -m venv /opt/server/venv && \
    /opt/server/venv/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/server/venv/bin/pip install --no-cache-dir \
      fastapi==0.139.0 "uvicorn[standard]==0.49.0" pydantic==2.13.4

# Maintenance pip targets the analyzer; the server uses its own venv below.
ENV PATH=/opt/analyzer/venv/bin:/opt/server/venv/bin:$PATH \
    ANALYZE_PYTHON=/opt/analyzer/venv/bin/python \
    ANALYZE_WORKER=/app/workers/analyze_worker.py

WORKDIR /app
COPY docker/analyzer/server.py /app/server.py
# The SAME worker the controller runs in-process — single source of truth.
COPY controller/scripts/analyze_worker.py /app/workers/analyze_worker.py
# The downbeat model (stage above) at the worker's default BEAT_THIS_MODEL.
COPY --from=beat-this /build/beat_this-small0.onnx /opt/analyzer/models/beat_this-small0.onnx

# Shared state mount — the controller pre-fetches tracks into
# /var/sub-wave/analyze-tmp. mkdir'd here so the image runs standalone too.
RUN mkdir -p /var/sub-wave && chmod 777 /var/sub-wave

# --- Drop root --------------------------------------------------------------
# The server only writes the shared mount, the HF cache, and librosa/numba's
# JIT cache. HOME/XDG/NUMBA point at a user-owned tree so numba's cache=True
# JIT files land somewhere writable; the hf-cache chown makes the compose named
# volume inherit ownership on first create.
ENV HOME=/home/subwave \
    XDG_CACHE_HOME=/home/subwave/.cache \
    NUMBA_CACHE_DIR=/home/subwave/.cache/numba
RUN groupadd -g 10001 subwave && \
    useradd -u 10001 -g 10001 -m -d /home/subwave -s /usr/sbin/nologin subwave && \
    mkdir -p /home/subwave/.cache/numba /opt/analyzer/hf-cache && \
    chown -R 10001:10001 /home/subwave /opt/analyzer/hf-cache
USER 10001:10001

EXPOSE 8080
CMD ["/opt/server/venv/bin/uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080"]
