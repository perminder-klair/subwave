# Caddy edge for the all-in-one image (docker/Dockerfile.aio). Same route
# table as the split-stack docker/Caddyfile, but every backend is loopback in
# this same container. No Cloudflare trusted_proxies block — the AIO is aimed
# at LAN / behind whatever proxy the operator already runs.
{
	auto_https off
}

:80 {
	# Icecast mounts. Opus/FLAC/AAC are off by default but must be listed or
	# they fall through to the catch-all and 404. flush_interval -1 keeps the
	# never-ending audio body live.
	@streams path /stream.mp3 /stream.opus /stream.flac /stream.aac
	handle @streams {
		# Icecast refuses a listener with a 401 carrying WWW-Authenticate: Basic.
		# ffmpeg, mpv and GStreamer send `user:pass@` only once challenged, so the
		# header stays by default. A media element on the station's own page can't
		# answer it: the browser raises its native "Sign in" dialog over the whole
		# page, which blocks the player until the station gate's next check. So
		# drop it for a request that marks itself as one of those: a token on the
		# URL (web player, app, Cast), or a media destination from this origin (the
		# same, before a token exists; browsers send that one to https and localhost
		# only). Another site's <audio> keeps it: Firefox answers with the login in
		# a `user:pass@` src. Only the header goes: the 401 and its body stay, and a
		# 200 has none to lose. The delete is deferred to the response, so it sees
		# what Icecast sent. In lockstep with docker/Caddyfile.
		@stream_token query auth=*
		@stream_element {
			header Sec-Fetch-Dest audio
			header Sec-Fetch-Dest video
			header Sec-Fetch-Site same-origin
		}
		header @stream_token -WWW-Authenticate
		header @stream_element -WWW-Authenticate

		reverse_proxy 127.0.0.1:7702 {
			flush_interval -1
			transport http {
				read_buffer 16KB
				response_header_timeout 30s
				dial_timeout 5s
			}
		}
	}

	# Icecast's URL-auth callback — NOT reachable from the internet (password
	# oracle otherwise; icecast calls the controller on loopback directly).
	# A prefix so a trailing slash is denied too. Kept in lockstep with
	# docker/Caddyfile.
	handle /api/listener-auth* {
		respond 404
	}

	# Controller REST API (prefix stripped so its routes stay at root).
	handle_path /api/* {
		reverse_proxy 127.0.0.1:7701
	}

	# One-paste tune-in files — served by the controller at its root (NOT under
	# /api), so plain handle, no path stripping.
	@listen path /listen.pls /listen.m3u
	handle @listen {
		reverse_proxy 127.0.0.1:7701
	}

	# Everything else → Next.js web UI.
	handle {
		reverse_proxy 127.0.0.1:7700
	}

	# Don't gzip the already-compressed live audio mounts.
	@compressible not path /stream.mp3 /stream.opus /stream.flac /stream.aac
	encode @compressible gzip zstd

	log {
		output stdout
		format console
	}
}
