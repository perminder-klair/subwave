# syntax=docker/dockerfile:1
# SUB/WAVE broadcast image — Icecast2 + Liquidsoap in one container.
# icecast2 serves listeners on :7702; liquidsoap connects over loopback and
# exposes telnet on :1234 (internal). broadcast-entrypoint.sh resolves the
# shared passwords, renders icecast.xml, launches both, and exits if either
# dies so the restart policy bounces them together.
#
# v2.4.6 minimum. 2.4.4's per-pull clock scan let the per-transition DJ effect
# chains (~30 operators) peg a core and stall the stream clock at every
# crossfade ("Latency is too high" → dead-air source resets); 2.4.5 made clock
# propagation push-based/O(1). 2.4.5 in turn grows unifier reference chains
# without bound on a long-running station (#5257, until now backported here
# from source), and its `sequence` drops the first partial frame of the
# incoming source after a `cross` transition (#5296), which put up to 20 ms of
# beat error on every stem-blend clip seam whose outgoing track ends mid-frame.
# Stock upstream release, pinned by manifest digest. Keep this stage identical
# in both Dockerfiles (CI compares the two executables); see docker/liquidsoap/.
FROM savonet/liquidsoap:v2.4.6@sha256:1d4ecfc1b53851c5f018d1ada430302a0678f789a6e96f6de5264255f679689c AS liquidsoap

FROM liquidsoap AS runtime

USER root

# Icecast-KH, not Debian's icecast2. The <x-forwarded-for> trusted-proxy list
# the entrypoint renders, and the listener-auth behaviour it relies on, are KH
# features: stock Icecast 2.4.4 boots, streams and ignores them, so every
# listener shows the edge's container IP and loses its country. KH comes from
# deb-multimedia, which the 2.4.5 base image happened to configure and 2.4.6
# does not. Pinned to icecast2 alone so the rest of DMO cannot replace Debian
# packages, the mixer's included: the stock 2.4.6 liquidsoap bundles a static
# FFmpeg and fdk-aac, but links Debian's libmp3lame0, libopus0, libflac and
# libvorbis dynamically, and DMO also ships libmp3lame0 (1:3.100-dmo3), so the
# pin keeps the MP3 encoder on Debian's build. Same for the AIO's CLI ffmpeg.
ADD --checksum=sha256:8dc6cbb266c701cfe58bd1d2eb9fe2245a1d6341c7110cfbfe3a5a975dcf97ca \
    https://www.deb-multimedia.org/pool/main/d/deb-multimedia-keyring/deb-multimedia-keyring_2024.9.1_all.deb \
    /tmp/deb-multimedia-keyring.deb
RUN dpkg-deb --fsys-tarfile /tmp/deb-multimedia-keyring.deb \
      | tar -xO ./usr/share/keyrings/deb-multimedia-keyring.pgp \
      > /usr/share/keyrings/deb-multimedia-keyring.pgp \
 && echo '11b17f001b376cea4bfdf541bbe4d40fef5391eb0772b9d61d68c2aca21de893  /usr/share/keyrings/deb-multimedia-keyring.pgp' | sha256sum -c - \
 && rm /tmp/deb-multimedia-keyring.deb \
 && printf '%s\n' 'Types: deb' 'URIs: https://www.deb-multimedia.org' 'Suites: trixie' \
        'Components: main' 'Signed-By: /usr/share/keyrings/deb-multimedia-keyring.pgp' \
        > /etc/apt/sources.list.d/dmo.sources \
 && printf '%s\n' 'Package: *' 'Pin: origin www.deb-multimedia.org' 'Pin-Priority: 100' '' \
        'Package: icecast2' 'Pin: origin www.deb-multimedia.org' 'Pin-Priority: 990' \
        > /etc/apt/preferences.d/dmo-icecast-kh

# sudo: drop privileges to icecast2/liquidsoap. openssl: first-boot secret
# generation. curl: liquidsoap's HTTPS Subsonic fetch + the entrypoint's
# "icecast up yet" probe.
RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends \
        icecast2 \
        sudo \
        openssl \
        curl \
        ca-certificates \
 && icecast2 -v 2>&1 | grep -q -- '-kh' \
 && rm -rf /var/lib/apt/lists/*

# Baked config + repo-bundled audio (prod is image-only; dev compose can still
# bind-mount over the top).
COPY docker/icecast.xml.template /etc/icecast2/icecast.xml.template
COPY liquidsoap/radio.liq /etc/liquidsoap/radio.liq
COPY sounds /sounds

COPY docker/broadcast-entrypoint.sh /usr/local/bin/broadcast-entrypoint
RUN chmod +x /usr/local/bin/broadcast-entrypoint

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=6 \
    CMD curl -fsS http://localhost:7702/status-json.xsl > /dev/null || exit 1

# Entrypoint runs as root so it can resolve secrets, render icecast.xml, and
# sudo into the per-process users.
USER root
ENTRYPOINT ["/usr/local/bin/broadcast-entrypoint"]
