{"code":"import assert from\"node:assert/strict\";import test from\"node:test\";import{skillEnabled,personaRunsSkill,skillEligible}from\"../src/skills/eligibility.js\";test(\"a seeded built-in is enabled unless explicitly turned off\",()=>{assert.equal(skillEnabled({seeded:true,skill:\"weather\",enabled:{}}),true);assert.equal(skillEnabled({seeded:true,skill:\"weather\",enabled:{weather:true}}),true);assert.equal(skillEnabled({seeded:true,skill:\"weather\",enabled:{weather:false}}),false)});test(\"an operator skill is discovered-but-disabled \\u2014 it must be turned ON\",()=>{assert.equal(skillEnabled({seeded:false,skill:\"dabbers\",enabled:{}}),false);assert.equal(skillEnabled({seeded:false,skill:\"dabbers\",enabled:{dabbers:true}}),true);assert.equal(skillEnabled({seeded:false,skill:\"dabbers\",enabled:{dabbers:false}}),false)});test(\"no persona allowlist means the persona runs every skill\",()=>{const base={seeded:true,skill:\"weather\",enabled:{}};assert.equal(personaRunsSkill({...base,personaSkills:void 0}),true);assert.equal(personaRunsSkill({...base,personaSkills:null}),true)});test('an empty allowlist is not \"no allowlist\" \\u2014 it runs nothing',()=>{assert.equal(personaRunsSkill({seeded:true,skill:\"weather\",enabled:{},personaSkills:[]}),false)});test(\"an allowlist admits only its own members\",()=>{const base={seeded:true,enabled:{}};assert.equal(personaRunsSkill({...base,skill:\"weather\",personaSkills:[\"weather\",\"news\"]}),true);assert.equal(personaRunsSkill({...base,skill:\"dabbers\",personaSkills:[\"weather\",\"news\"]}),false)});test(\"skillEligible is a strict AND and names which rule closed it\",()=>{assert.deepEqual(skillEligible({seeded:true,skill:\"weather\",enabled:{},personaSkills:[\"weather\"]}),{allowed:true});const disabled=skillEligible({seeded:false,skill:\"dabbers\",enabled:{},personaSkills:[\"dabbers\"]});assert.equal(disabled.allowed,false);assert.match(disabled.reason||\"\",/disabled/);const notOwned=skillEligible({seeded:true,skill:\"weather\",enabled:{},personaSkills:[\"news\"]});assert.equal(notOwned.allowed,false);assert.match(notOwned.reason||\"\",/persona/)});test(\"the disabled rule is reported first when both rules are closed\",()=>{const both=skillEligible({seeded:false,skill:\"dabbers\",enabled:{},personaSkills:[\"news\"]});assert.equal(both.allowed,false);assert.match(both.reason||\"\",/disabled/)});\n","warnings":[],"map":{"version":3,"mappings":"AAeA,OAAO,WAAY,qBACnB,OAAO,SAAU,YAEjB,OAAS,aAAc,iBAAkB,kBAAqB,+BAE9D,KAAK,4DAA6D,IAAM,CACtE,OAAO,MAAM,aAAa,CAAE,OAAQ,KAAM,MAAO,UAAW,QAAS,CAAC,CAAE,CAAC,EAAG,IAAI,EAChF,OAAO,MAAM,aAAa,CAAE,OAAQ,KAAM,MAAO,UAAW,QAAS,CAAE,QAAS,IAAK,CAAE,CAAC,EAAG,IAAI,EAC/F,OAAO,MAAM,aAAa,CAAE,OAAQ,KAAM,MAAO,UAAW,QAAS,CAAE,QAAS,KAAM,CAAE,CAAC,EAAG,KAAK,CACnG,CAAC,EAED,KAAK,2EAAuE,IAAM,CAGhF,OAAO,MAAM,aAAa,CAAE,OAAQ,MAAO,MAAO,UAAW,QAAS,CAAC,CAAE,CAAC,EAAG,KAAK,EAClF,OAAO,MAAM,aAAa,CAAE,OAAQ,MAAO,MAAO,UAAW,QAAS,CAAE,QAAS,IAAK,CAAE,CAAC,EAAG,IAAI,EAChG,OAAO,MAAM,aAAa,CAAE,OAAQ,MAAO,MAAO,UAAW,QAAS,CAAE,QAAS,KAAM,CAAE,CAAC,EAAG,KAAK,CACpG,CAAC,EAED,KAAK,0DAA2D,IAAM,CACpE,MAAM,KAAO,CAAE,OAAQ,KAAM,MAAO,UAAW,QAAS,CAAC,CAAE,EAC3D,OAAO,MAAM,iBAAiB,CAAE,GAAG,KAAM,cAAe,MAAU,CAAC,EAAG,IAAI,EAC1E,OAAO,MAAM,iBAAiB,CAAE,GAAG,KAAM,cAAe,IAAK,CAAC,EAAG,IAAI,CACvE,CAAC,EAED,KAAK,kEAA8D,IAAM,CAGvE,OAAO,MAAM,iBAAiB,CAAE,OAAQ,KAAM,MAAO,UAAW,QAAS,CAAC,EAAG,cAAe,CAAC,CAAE,CAAC,EAAG,KAAK,CAC1G,CAAC,EAED,KAAK,2CAA4C,IAAM,CACrD,MAAM,KAAO,CAAE,OAAQ,KAAM,QAAS,CAAC,CAAE,EACzC,OAAO,MAAM,iBAAiB,CAAE,GAAG,KAAM,MAAO,UAAW,cAAe,CAAC,UAAW,MAAM,CAAE,CAAC,EAAG,IAAI,EACtG,OAAO,MAAM,iBAAiB,CAAE,GAAG,KAAM,MAAO,UAAW,cAAe,CAAC,UAAW,MAAM,CAAE,CAAC,EAAG,KAAK,CACzG,CAAC,EAED,KAAK,+DAAgE,IAAM,CACzE,OAAO,UACL,cAAc,CAAE,OAAQ,KAAM,MAAO,UAAW,QAAS,CAAC,EAAG,cAAe,CAAC,SAAS,CAAE,CAAC,EACzF,CAAE,QAAS,IAAK,CAClB,EAEA,MAAM,SAAW,cAAc,CAAE,OAAQ,MAAO,MAAO,UAAW,QAAS,CAAC,EAAG,cAAe,CAAC,SAAS,CAAE,CAAC,EAC3G,OAAO,MAAM,SAAS,QAAS,KAAK,EACpC,OAAO,MAAM,SAAS,QAAU,GAAI,UAAU,EAE9C,MAAM,SAAW,cAAc,CAAE,OAAQ,KAAM,MAAO,UAAW,QA