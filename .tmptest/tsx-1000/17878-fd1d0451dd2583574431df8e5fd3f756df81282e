ablished moods\");assert.ok(pruned.energetic,\"a mood that clears the floor survives\");assert.equal(pruned.newcomer,void 0,\"the thin mood is dropped from the baselines\");assert.equal(centeredScores({energetic:.35,newcomer:.9},pruned).newcomer,void 0)});test(\"pruning everything is the same as having no baselines\",()=>{assert.equal(prunedBaselines(computeBaselines(syntheticLibrary(10))),null);assert.equal(prunedBaselines(null),null);assert.equal(prunedBaselines({}),null)});test(\"a pass that could not calibrate does not stamp itself as current\",()=>{const vocab=\"abc123\";const uncalibrated=moodStateHashFor(vocab,false);assert.equal(parseMoodStateHash(uncalibrated).version,UNCALIBRATED_VERSION);assert.equal(moodPassAction(uncalibrated,vocab),\"relabel\",\"a grown library re-derives labels rather than reporting nothing to do\");assert.equal(moodStateHashFor(vocab,true),composeMoodStateHash(vocab,CALIBRATION_VERSION));assert.equal(moodPassAction(moodStateHashFor(vocab,true),vocab),\"none\")});test(\"centring expresses each score in that mood own standard deviations\",()=>{const b=computeBaselines([{calm:0},{calm:2}]);assert.equal(centeredScores({calm:2},b).calm,1);assert.equal(centeredScores({calm:1},b).calm,0);assert.equal(centeredScores({calm:0},b).calm,-1)});test(\"a mood with no baseline is dropped, never mixed in raw\",()=>{const b=computeBaselines([{calm:0},{calm:2}]);const z=centeredScores({calm:2,brandNew:.9},b);assert.deepEqual(Object.keys(z),[\"calm\"],\"raw cosines never share an axis with z-scores\")});test(\"a zero-variance mood cannot explode into a runaway winner\",()=>{const b=computeBaselines([{flat:.2},{flat:.2},{flat:.2}]);const z=centeredScores({flat:.2},b);assert.ok(Number.isFinite(z.flat),\"no divide-by-zero\");assert.ok(Math.abs(z.flat)<1e-9,`expected ~0, got ${z.flat}`)});test(\"a high-baseline mood no longer wins every track (issue #1362)\",()=>{const lib=syntheticLibrary(400);const b=computeBaselines(lib);const rawWins=lib.filter(s=>topMood(selectAudioMoods(s,null))===\"energetic\").length;assert.equal(rawWins,lib.length,\"precondition: raw selection is dominated by one mood\");const calmTrack={energetic:.3,calm:.15,night:.1};assert.equal(topMood(selectAudioMoods(calmTrack,b)),\"calm\");const energeticTrack={energetic:.4,calm:.05,night:.1};assert.equal(topMood(selectAudioMoods(energeticTrack,b)),\"energetic\")});test(\"calibrated selection spreads labels across the vocabulary\",()=>{const lib=syntheticLibrary(400);const b=computeBaselines(lib);const wins=new Set(lib.map(s=>topMood(selectAudioMoods(s,b))));assert.ok(wins.size>1,`expected more than one mood to ever win, got ${[...wins]}`)});test(\"thin baselines fall back to raw selection, unchanged from pre-calibration\",()=>{const scores={energetic:.35,calm:.1};const thin=computeBaselines(syntheticLibrary(5));assert.deepEqual(selectAudioMoods(scores,thin),selectAudioMoods(scores,null),\"below the floor, behaviour is byte-for-byte the old path\")});test(\"selection keeps its shape: best-first, margin, cap\",()=>{const b=computeBaselines(syntheticLibrary(400));const picked=selectAudioMoods({energetic:.4,calm:.15,night:.12},b,{max:2});assert.ok(picked.length<=2,\"cap holds on the calibrated axis\");assert.deepEqual(selectAudioMoods({},b),[],\"empty score map yields no labels\")});function topMood(labels){return labels[0]??null}__name(topMood,\"topMood\");function energyLibrary(n){const rows=[];for(let i=0;i<n;i++){const t=i%100/100;rows.push({energetic:.1+t*.2,workout:.1+t*.2,driving:.1+t*.2,celebratory:.1+t*.2,festival:.1+t*.2,calm:.3-t*.2,reflective:.3-t*.2,spiritual:.3-t*.2,focus:.3-t*.2,night:.3-t*.2})}return rows}__name(energyLibrary,\"energyLibrary\");test(\"a loud track reads high and a quiet one reads low\",()=>{const b=computeBaselines(energyLibrary(400));const loud={energetic:.3,workout:.3,driving:.3,celebratory:.3,festival:.3,calm:.1,reflective:.1,spiritual:.1,focus:.1,night:.1};const quiet={energetic:.1,workout:.1,driving:.1,celebratory:.1,