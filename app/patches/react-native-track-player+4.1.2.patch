+package com.doublesymmetry.trackplayer.model
+
+import android.os.SystemClock
+import android.support.v4.media.session.PlaybackStateCompat
+import com.doublesymmetry.kotlinaudio.notification.NotificationManager
+import com.google.android.exoplayer2.C
+import com.google.android.exoplayer2.ForwardingPlayer
+import com.google.android.exoplayer2.Player
+import com.google.android.exoplayer2.ext.mediasession.MediaSessionConnector
+
+/** Song time for the media session, independent of the continuous stream's position. */
+class NowPlayingProgress(private val manager: NotificationManager) {
+    // KotlinAudio 2.1.0 exposes no session-player adapter. These two pinned
+    // fields are kept by consumer ProGuard rules; the audio player is untouched.
+    private fun sessionField(name: String): Any =
+        NotificationManager::class.java.getDeclaredField(name).let {
+            it.isAccessible = true
+            it.get(manager)!!
+        }
+
+    private val connector = sessionField("mediaSessionConnector") as MediaSessionConnector
+    private val source = sessionField("player") as Player
+    private var durationMs: Long? = null
+    private var elapsedMs: Long? = null
+    private var updatedAt = SystemClock.elapsedRealtime()
+    private var running = source.isPlaying
+    private var speed = source.playbackParameters.speed
+    private var enabled = false
+
+    private fun position(): Long {
+        val elapsed = elapsedMs ?: return PlaybackStateCompat.PLAYBACK_POSITION_UNKNOWN
+        val delta = if (running) ((SystemClock.elapsedRealtime() - updatedAt) * speed).toLong() else 0L
+        return (elapsed + delta).coerceAtMost(durationMs ?: Long.MAX_VALUE)
+    }
+
+    private val sessionPlayer = object : ForwardingPlayer(source) {
+        override fun getCurrentPosition(): Long = if (enabled) position() else super.getCurrentPosition()
+        override fun getBufferedPosition(): Long = if (enabled) position() else super.getBufferedPosition()
+        override fun getDuration(): Long = if (enabled) durationMs ?: C.TIME_UNSET else super.getDuration()
+    }
+
+    init {
+        source.addListener(object : Player.Listener {
+            override fun onEvents(player: Player, events: Player.Events) {
+                if (elapsedMs != null) elapsedMs = position()
+                updatedAt = SystemClock.elapsedRealtime()
+                running = source.isPlaying
+                speed = source.playbackParameters.speed
+            }
+        })
+        // Preserve KotlinAudio's Play/Pause/Stop interception and listener wiring.
+        connector.setPlayer(sessionPlayer)
+    }
+
+    fun update(duration: Double?, elapsed: Double?) {
+        enabled = true
+        durationMs = duration?.takeIf { it.isFinite() && it > 0 }?.let { (it * 1000).toLong() }
+        elapsedMs = elapsed?.takeIf { it.isFinite() && it >= 0 && durationMs != null }
+            ?.let { (it * 1000).toLong() }
+        updatedAt = SystemClock.elapsedRealtime()
+        running = source.isPlaying
+        speed = source.playbackParameters.speed
+        connector.invalidateMediaSessionPlaybackState()
+    }
+
+    fun clear() {
+        enabled = false
+        durationMs = null
+        elapsedMs = null
+        connector.invalidateMediaSessionPlaybackState()
+    }
+}
