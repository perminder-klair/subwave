# Copy this file to alexa-skill-package/alexa.env and replace every example value.
# Do not commit alexa-skill-package/alexa.env.
ALEXA_ENDPOINT_URL=https://your-deployment.example/api/alexa
ALEXA_SKILL_NAME=My Radio
ALEXA_INVOCATION_NAME=my radio
ALEXA_DESCRIPTION=A voice skill for a self-hosted radio.
ALEXA_SUMMARY=Control a self-hosted radio with Alexa.
ALEXA_TESTING_INSTRUCTIONS=Use the configured invocation name to test the development skill.
